{
  "pluginAlias": "LGThinQ",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "strictValidation": false,
  "schema": {
    "name": {
      "title": "Name",
      "type": "string",
      "default": "LGThinQ",
      "description": "Prefix of this plugin in the Homebridge log. The Plugin Logs window shows the log lines with this prefix."
    },
    "auth_mode": {
      "title": "Auth Mode",
      "type": "string",
      "default": "account",
      "oneOf": [
        {
          "title": "LG Account",
          "enum": [
            "account"
          ]
        },
        {
          "title": "Token",
          "enum": [
            "token"
          ]
        }
      ]
    },
    "username": {
      "title": "Username",
      "type": "string",
      "condition": {
        "functionBody": "return model.auth_mode === 'account';"
      }
    },
    "password": {
      "title": "Password",
      "type": "string",
      "condition": {
        "functionBody": "return model.auth_mode === 'account';"
      }
    },
    "refresh_token": {
      "title": "Refresh Token",
      "type": "string",
      "condition": {
        "functionBody": "return model.auth_mode === 'token';"
      }
    },
    "country": {
      "title": "Country",
      "type": "string",
      "default": "US",
      "required": true
    },
    "language": {
      "title": "Language",
      "type": "string",
      "default": "en-US",
      "required": true
    },
    "thinq1": {
      "title": "Enable ThinQ1 Support?",
      "type": "boolean",
      "default": false
    },
    "refresh_interval": {
      "title": "Refresh interval (in second)",
      "type": "number",
      "default": 60,
      "condition": {
        "functionBody": "return !!model.thinq1;"
      }
    },
    "devices": {
      "title": "Devices",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "title": "Device ID",
            "type": "string",
            "required": true
          },
          "name": {
            "title": "Device Name",
            "type": "string"
          },
          "serial_number": {
            "title": "Serial Number (optional)",
            "type": "string"
          },
          "type": {
            "title": "Device Type",
            "type": "string"
          },
          "dishwasher_trigger": {
            "title": "Program finished sensor",
            "type": "boolean",
            "description": "Adds an occupancy sensor that turns on when a program finishes. Use it in a HomeKit automation, for example to get a notification."
          },
          "washer_tub_clean": {
            "title": "Tub clean reminder",
            "type": "boolean",
            "description": "Adds an occupancy sensor that turns on when the washer recommends a tub clean."
          },
          "washer_trigger": {
            "title": "Program finished sensor",
            "type": "boolean",
            "description": "Adds an occupancy sensor that turns on when a program finishes. Use it in a HomeKit automation, for example to get a notification."
          },
          "washer_door_lock": {
            "title": "Door lock status",
            "type": "boolean",
            "description": "Shows whether the door is locked, as a lock in HomeKit. Only for models that report it."
          },
          "ac_air_quality": {
            "title": "Air quality sensor",
            "description": "Adds an air quality sensor, if the air conditioner has one.",
            "type": "boolean"
          },
          "ac_mode": {
            "title": "Modes shown in HomeKit",
            "type": "string",
            "oneOf": [
              {
                "title": "Both Heating and Cooling mode",
                "enum": [
                  "BOTH"
                ]
              },
              {
                "title": "Cooling mode only",
                "enum": [
                  "COOLING"
                ]
              },
              {
                "title": "Heating mode only",
                "enum": [
                  "HEATING"
                ]
              }
            ]
          },
          "ac_swing_mode": {
            "title": "Swing control",
            "type": "string",
            "oneOf": [
              {
                "title": "No swing",
                "enum": [
                  "NONE"
                ]
              },
              {
                "title": "Both vertical and horizontal swing",
                "enum": [
                  "BOTH"
                ]
              },
              {
                "title": "Vertical swing only",
                "enum": [
                  "VERTICAL"
                ]
              },
              {
                "title": "Horizontal swing only",
                "enum": [
                  "HORIZONTAL"
                ]
              }
            ]
          },
          "ac_temperature_sensor": {
            "title": "Temperature sensor",
            "type": "boolean",
            "description": "Adds the current room temperature as a separate sensor."
          },
          "ac_humidity_sensor": {
            "title": "Humidity sensor",
            "type": "boolean",
            "description": "Adds a humidity sensor, if the air conditioner reports humidity."
          },
          "ac_led_control": {
            "title": "Display light switch",
            "type": "boolean",
            "description": "Adds a switch to turn the display light on and off."
          },
          "ac_fan_control": {
            "title": "Separate fan control",
            "type": "boolean",
            "description": "Adds a fan to control the fan speed separately from the air conditioner."
          },
          "ac_jet_control": {
            "title": "Jet mode switch",
            "type": "boolean",
            "description": "Adds a switch for jet mode, on models that support it."
          },
          "ac_buttons": {
            "title": "Mode buttons",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "title": "Button name",
                  "type": "string",
                  "description": "The name of the switch in HomeKit, for example \"Dry mode\". Leave empty if you do not want mode buttons."
                },
                "op_mode": {
                  "title": "Mode",
                  "type": "integer",
                  "oneOf": [
                    {
                      "title": "Cool",
                      "enum": [
                        0
                      ]
                    },
                    {
                      "title": "Dry",
                      "enum": [
                        1
                      ]
                    },
                    {
                      "title": "Fan",
                      "enum": [
                        2
                      ]
                    },
                    {
                      "title": "Heat",
                      "enum": [
                        4
                      ]
                    },
                    {
                      "title": "Air clean",
                      "enum": [
                        5
                      ]
                    },
                    {
                      "title": "Auto",
                      "enum": [
                        6
                      ]
                    }
                  ]
                }
              }
            }
          },
          "ac_energy_save": {
            "title": "Energy saving switch",
            "type": "boolean",
            "description": "Adds a switch for energy saving mode, on models that support it."
          },
          "ac_air_clean": {
            "title": "Air purification switch",
            "type": "boolean",
            "description": "Adds a switch for air purification, on models that support it."
          },
          "ac_temperature_unit": {
            "title": "Temperature unit",
            "type": "string",
            "oneOf": [
              {
                "title": "Celsius",
                "enum": [
                  "C"
                ]
              },
              {
                "title": "Fahrenheit",
                "enum": [
                  "F"
                ]
              }
            ],
            "description": "The unit the air conditioner uses."
          },
          "ref_express_freezer": {
            "title": "Express Freezer / Ice Plus switch",
            "type": "boolean",
            "description": "Adds a switch for Express Freezer or Ice Plus, if the refrigerator has it."
          },
          "ref_express_fridge": {
            "title": "Express Fridge switch",
            "type": "boolean",
            "description": "Adds a switch for Express Fridge, if the refrigerator has it."
          },
          "ref_eco_friendly": {
            "title": "Eco Friendly switch",
            "type": "boolean",
            "description": "Adds a switch for Eco Friendly mode, if the refrigerator has it."
          },
          "air_fast_mode": {
            "title": "Fast mode switch",
            "type": "boolean",
            "description": "Adds a switch for the fast mode of the air purifier."
          }
        }
      }
    }
  },
  "layout": [
    "auth_mode",
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": [
        "username",
        {
          "key": "password",
          "type": "password"
        }
      ]
    },
    "refresh_token",
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": [
        "country",
        "language"
      ]
    },
    {
      "key": "devices",
      "type": "tabarray",
      "title": "{{ value.name || 'new device' }}",
      "items": [
        "devices[].name",
        "devices[].id",
        "devices[].serial_number",
        {
          "key": "devices[]",
          "type": "fieldset",
          "items": [
            {
              "type": "fieldset",
              "title": "Air purifier options",
              "items": [
                "devices[].air_fast_mode"
              ],
              "condition": {
                "functionBody": "return model.devices && model.devices[arrayIndices] && ['AIR_PURIFIER'].includes(model.devices[arrayIndices].type);"
              },
              "htmlClass": "border-top mt-4 pt-3"
            },
            {
              "type": "fieldset",
              "title": "Washer and dryer options",
              "items": [
                "devices[].washer_trigger",
                "devices[].washer_tub_clean",
                "devices[].washer_door_lock"
              ],
              "condition": {
                "functionBody": "return model.devices && model.devices[arrayIndices] && ['WASHER','WASHER_NEW', 'WASH_TOWER', 'DRYER', 'WASH_TOWER_2'].includes(model.devices[arrayIndices].type);"
              },
              "htmlClass": "border-top mt-4 pt-3"
            },
            {
              "type": "fieldset",
              "title": "Air conditioner options",
              "items": [
                "devices[].ac_mode",
                "devices[].ac_swing_mode",
                "devices[].ac_temperature_unit",
                "devices[].ac_air_quality",
                "devices[].ac_temperature_sensor",
                "devices[].ac_humidity_sensor",
                "devices[].ac_led_control",
                "devices[].ac_fan_control",
                "devices[].ac_jet_control",
                "devices[].ac_energy_save",
                "devices[].ac_air_clean",
                {
                  "key": "devices[].ac_buttons",
                  "title": "Mode buttons",
                  "description": "Adds a switch for each mode you list. Turning a switch on sets the air conditioner to that mode; turning it off goes back to cooling.",
                  "type": "array",
                  "buttonText": "Add button",
                  "items": [
                    "devices[].ac_buttons[].name",
                    "devices[].ac_buttons[].op_mode"
                  ],
                  "listItems": 0,
                  "htmlClass": "mt-3"
                }
              ],
              "condition": {
                "functionBody": "return model.devices && model.devices[arrayIndices] && ['AC'].includes(model.devices[arrayIndices].type);"
              },
              "htmlClass": "border-top mt-4 pt-3"
            },
            {
              "type": "fieldset",
              "title": "Refrigerator options",
              "items": [
                "devices[].ref_express_freezer",
                "devices[].ref_express_fridge",
                "devices[].ref_eco_friendly"
              ],
              "condition": {
                "functionBody": "return model.devices && model.devices[arrayIndices] && ['REFRIGERATOR'].includes(model.devices[arrayIndices].type);"
              },
              "htmlClass": "border-top mt-4 pt-3"
            },
            {
              "type": "fieldset",
              "title": "Dishwasher options",
              "items": [
                "devices[].dishwasher_trigger"
              ],
              "condition": {
                "functionBody": "return model.devices && model.devices[arrayIndices] && ['DISHWASHER'].includes(model.devices[arrayIndices].type);"
              },
              "htmlClass": "border-top mt-4 pt-3"
            }
          ]
        }
      ]
    }
  ]
}
